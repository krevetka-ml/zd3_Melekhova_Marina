<Window x:Class="zd3_Melekhova_Marina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zd3_Melekhova_Marina"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Оценка качества продуктов" Height="750" Width="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--МЕНЮ ПРОГРАММЫ-->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <Separator/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Просмотр">
                <MenuItem Header="Все продукты" Click="MenuShowAll_Click"/>
                <MenuItem Header="Только базовые" Click="MenuShowBase_Click"/>
                <MenuItem Header="Только наследники" Click="MenuShowExtended_Click"/>
                <Separator/>
            </MenuItem>
        </Menu>

        <!--ОСНОВНАЯ ОБЛАСТЬ-->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--ЛЕВАЯ ВЕРХНЯЯ ПАНЕЛЬ: ПОЛЯ ДЛЯ ВВОДА-->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" 
                    CornerRadius="5" Padding="10" Margin="0,0,10,10">
                <StackPanel>

                    <TextBlock x:Name="txtMode" Text="Заполните поля и нажмите кнопку" 
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!--ОБЩИЕ ДАННЫЕ-->
                    <TextBlock Text="ОБЩИЕ ДАННЫЕ (заполняются всегда)" 
                               FontWeight="Bold" Margin="0,0,0,10" Background="#E8E8E8" Padding="5"/>

                    <TextBlock Text="Название продукта:" FontSize="12" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtName" Margin="0,3" Text="Молоко"/>

                    <TextBlock Text="Белки (граммы на 100г):" FontSize="12" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtProtein" Margin="0,3" Text="3.2"/>

                    <TextBlock Text="Углеводы (граммы на 100г):" FontSize="12" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtCarbs" Margin="0,3" Text="4.8"/>

                    <TextBlock Text="Жиры (граммы на 100г):" FontSize="12" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtFats" Margin="0,3" Text="2.5"/>

                    <TextBlock Text="Дата производства (выберите в календаре):" FontSize="12" Margin="0,5,0,0"/>
                    <DatePicker x:Name="dpDate" Margin="0,3" SelectedDate="{x:Static sys:DateTime.Now}"/>

                    <!--ДОПОЛНИТЕЛЬНЫЕ ДАННЫЕ (ПОЯВЛЯЮТСЯ ПРИ НАЖАТИИ НА ДОБАВЛЕНИЕ НАСЛЕДНИКА)-->
                    <TextBlock x:Name="lblExtended" 
                               Text="ДОПОЛНИТЕЛЬНЫЕ ДАННЫЕ (только для продуктов-наследников)" 
                               FontWeight="Bold" Margin="0,15,0,5" Background="#E8E8E8" Padding="5" Visibility="Collapsed"/>

                    <TextBlock x:Name="lblCalories" Text="Калорийность (ккал на 100г):" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBox x:Name="txtCalories" Margin="0,3" Text="350" Visibility="Collapsed"/>

                    <TextBlock x:Name="lblManufacturer" Text="Производитель:" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBox x:Name="txtManufacturer" Margin="0,3" Text="ООО Молпродукт" Visibility="Collapsed"/>

                    <TextBlock x:Name="lblWeight" Text="Вес упаковки (граммы):" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBox x:Name="txtWeight" Margin="0,3" Text="200" Visibility="Collapsed"/>

                    <Separator Margin="0,15"/>

                    <Border Background="LightGreen" Padding="5" Margin="0,0,0,5" CornerRadius="5">
                        <TextBlock Text="БАЗОВЫЙ ПРОДУКТ (FoodProduct)" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Формула качества: Q = углеводы×4 + белки×4" FontSize="11" Foreground="DarkGreen" Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Button x:Name="btnAddBaseParams" Content="1. Добавить (через параметры)" Width="180" Height="35" 
                                Click="BtnAddBaseByParams_Click" Margin="0,0,10,0" Background="LightGreen"/>
                        <Button x:Name="btnAddBaseArray" Content="2. Добавить (через массив)" Width="180" Height="35" 
                                Click="BtnAddBaseByArray_Click" Background="LightGreen"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Button x:Name="btnDeleteBaseName" Content="3. Удалить (по имени)" Width="180" Height="35" 
                                Click="BtnDeleteBaseByName_Click" Margin="0,0,10,0" Background="LightCoral"/>
                        <Button x:Name="btnDeleteBaseIndex" Content="4. Удалить (по индексу)" Width="180" Height="35" 
                                Click="BtnDeleteBaseByIndex_Click" Background="LightCoral"/>
                    </StackPanel>

                    <Separator Margin="0,15"/>

                    <Border Background="LightBlue" Padding="5" Margin="0,0,0,5" CornerRadius="5">
                        <TextBlock Text="ПРОДУКТ-НАСЛЕДНИК (ExtendedFoodProduct)" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Формула качества: Qp = Q×1,2 + калорийность×7" FontSize="11" Foreground="DarkBlue" Margin="0,0,0,5"/>

                    <Button x:Name="btnAddExtended" Content="Добавить продукт-наследник" Width="220" Height="35" 
                            Click="BtnAddExtended_Click" Margin="0,5" Background="LightBlue"/>
                    <Button x:Name="btnDeleteExtended" Content="Удалить продукт-наследник" Width="220" Height="35" 
                            Click="BtnDeleteExtended_Click" Margin="0,5" Background="LightCoral"/>

                    <!--статус бар-->
                    <TextBlock x:Name="lblStatus" Text="Готов к работе" Foreground="Green" Margin="0,10,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!--ЛЕВАЯ НИЖНЯЯ ПАНЕЛЬ: ИНФОРМАЦИЯ О ВЫБРАННОМ ПРОДУКТЕ-->
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" 
                    CornerRadius="5" Padding="10" Margin="0,10,10,0">
                <StackPanel>
                    <TextBlock Text="ИНФОРМАЦИЯ О ВЫБРАННОМ ПРОДУКТЕ" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="(кликните на продукт в списке справа)" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInfo" IsReadOnly="True" TextWrapping="Wrap" 
                             MinHeight="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!--ПРАВАЯ ПАНЕЛЬ: СПИСОК ПРОДУКТОВ-->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" BorderBrush="Gray" 
                    BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="СПИСОК ПРОДУКТОВ" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="(нажмите на продукт для просмотра информации)" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>
                    <ListBox x:Name="lstProducts" SelectionChanged="LstProducts_SelectionChanged" MinHeight="450"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>